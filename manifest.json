{
  "id": "com.99desains.sampul",
  "name": "Sampul - Palet & Tipografi",
  "version": "1.4.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "developer": {
    "id": "com.99desains",
    "name": "99 Desains"
  },
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess"
  },
  "icons": [
    {
      "width": 20,
      "height": 20,
      "path": "icons/icon_D.png",
      "scale": [1, 2],
      "theme": ["dark", "darkest"],
      "species": ["generic"]
    },
    {
      "width": 20,
      "height": 20,
      "path": "icons/icon_N.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["generic"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "sampulPanel",
      "label": {
        "default": "Sampul"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "maximumSize": {
        "width": 1600,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 820
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 860
      }
    }
  ]
}
